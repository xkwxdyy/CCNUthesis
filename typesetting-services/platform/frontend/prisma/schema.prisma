// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  phone         String?
  wechat        String?
  referralCode  String    @unique
  balance       Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  orders        Order[]
  referredBy    Referral[] @relation("referrer")
  referred      Referral[] @relation("referred")
  sessions      Session[]
}

// Order model
model Order {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("pending") // pending, processing, completed, cancelled
  totalPrice    Float
  depositPaid   Boolean   @default(false)
  finalPaid     Boolean   @default(false)
  pageCount     Int       @default(0)
  formulaCount  Int       @default(0)
  tableCount    Int       @default(0)
  refCount      Int       @default(0)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id])
  files         ProjectFile[]
  revisions     Revision[]
  payments      Payment[]
  referral      Referral?
}

// Project file model
model ProjectFile {
  id            String    @id @default(cuid())
  orderId       String
  fileType      String    // original, converted, final
  originalPath  String?
  convertedPath String?
  status        String    @default("pending") // pending, processing, completed, failed
  createdAt     DateTime  @default(now())
  
  order         Order     @relation(fields: [orderId], references: [id])
}

// Revision model
model Revision {
  id            String    @id @default(cuid())
  orderId       String
  description   String
  filePath      String?
  status        String    @default("pending") // pending, processing, completed
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  
  order         Order     @relation(fields: [orderId], references: [id])
}

// Referral model
model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referredId    String
  orderId       String?   @unique
  rewardAmount  Float     @default(30)
  status        String    @default("pending") // pending, completed, cancelled
  createdAt     DateTime  @default(now())
  
  referrer      User      @relation("referrer", fields: [referrerId], references: [id])
  referred      User      @relation("referred", fields: [referredId], references: [id])
  order         Order?    @relation(fields: [orderId], references: [id])
}

// Payment model
model Payment {
  id            String    @id @default(cuid())
  orderId       String
  type          String    // deposit, final
  amount        Float
  method        String    // wechat, alipay
  transactionId String?
  status        String    @default("pending") // pending, completed, failed, refunded
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  
  order         Order     @relation(fields: [orderId], references: [id])
}

// Session model for authentication
model Session {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id])
}